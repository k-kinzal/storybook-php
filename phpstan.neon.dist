includes:
  - vendor/phpstan/phpstan/conf/bleedingEdge.neon
  - vendor/k-kinzal/php-ai-toolkit/error-formatter.neon

parameters:
  level: max
  paths:
    - src/php
  tmpDir: .phpstan/cache
  phpVersion:
    min: 80000
    max: 80500
  exceptions:
    implicitThrows: false
    reportUncheckedExceptionDeadCatch: false
    check:
      missingCheckedExceptionInThrows: true
      tooWideThrowType: true
    uncheckedExceptionClasses:
      - LogicException
      - RuntimeException
      - Error
      - Random\RandomException
      - PHPUnit\Framework\MockObject\Exception
  customRules:
    unitTestMarker: '/tests/'
    broadCatchAllowedPaths:
      - 'src/php/runtime_boundary.php'
