includes:
  - vendor/phpstan/phpstan-strict-rules/rules.neon
  - vendor/k-kinzal/php-ai-toolkit/extension.neon
  - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
  level: max
  paths:
    - src/php
    - tests/Unit
  toolkit:
    mutation:
      enabled: true
    forbiddenTermsByPath:
      'src/php/Runtime/*':
        - Illuminate
        - Laravel
        - Symfony
        - CakePHP
        - 'Cake\'
        - CodeIgniter
        - Nette
