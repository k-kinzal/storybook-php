{
  "name": "storybook-php/example-cakephp",
  "description": "CakePHP view rendering example for storybook-php",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "cakephp/core": "^5.0"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "autoload": {
    "psr-4": {
      "App\\Components\\": "src/"
    }
  }
}
