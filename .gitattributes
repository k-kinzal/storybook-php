# Auto detect text files and ensure LF line endings
* text=auto eol=lf

# Explicit file type settings
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.php text eol=lf
*.html text eol=lf
*.css text eol=lf

# Mark generated files (hide diffs on GitHub)
package-lock.json linguist-generated
composer.lock* linguist-generated

# Mark vendored/example PHP files so GitHub language stats show TS as primary
examples/**/*.php linguist-vendored
src/__tests__/fixtures/*.php linguist-vendored

# Exclude non-essential files from `git archive` / GitHub source downloads
.github/ export-ignore
examples/ export-ignore
src/__tests__/ export-ignore
AGENTS.md export-ignore
.editorconfig export-ignore
.gitattributes export-ignore
.npmignore export-ignore
.php-cs-fixer.dist.php export-ignore
infection.json5 export-ignore
loc.yaml export-ignore
phpcs.xml.dist export-ignore
phpstan.neon export-ignore
phpunit.xml.dist export-ignore
rector.php export-ignore
tree.yaml export-ignore
composer.lock.php-* export-ignore
