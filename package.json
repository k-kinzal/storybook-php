{
  "name": "storybook-php",
  "version": "0.1.0",
  "description": "Storybook 10 framework addon for rendering PHP components as stories",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./ts-plugin": {
      "types": "./dist/ts-plugin/index.d.ts",
      "default": "./dist/ts-plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "storybook-php": "./dist/cli.js"
  },
  "files": [
    "dist",
    "client.d.ts",
    "src/php",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "typegen": "node dist/cli.js typegen",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "storybook": "^10.0.0",
    "vite": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "storybook": {
      "optional": false
    },
    "vite": {
      "optional": false
    }
  },
  "devDependencies": {
    "@storybook/builder-vite": "^10.2.19",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^27.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "storybook",
    "php",
    "storybook-addon",
    "storybook-framework",
    "component-driven",
    "ui"
  ]
}
